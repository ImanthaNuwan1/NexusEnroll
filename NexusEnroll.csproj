<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <RootNamespace>NexusEnroll</RootNamespace>
    <AssemblyName>NexusEnroll</AssemblyName>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <!-- The web API bridge lives in ./api as its own project; keep it out of this console app's build. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);api/**</DefaultItemExcludes>
  </PropertyGroup>
</Project>
