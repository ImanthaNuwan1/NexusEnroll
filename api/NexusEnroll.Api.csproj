<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>NexusEnroll.Api</RootNamespace>
    <AssemblyName>NexusEnroll.Api</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- Reuses the existing console app's Models/Services/Patterns as a library; its Main is never invoked. -->
    <ProjectReference Include="..\NexusEnroll.csproj" />
  </ItemGroup>
</Project>
